      "statusYawVelocityVehicle": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "момент мотора в панели",
      "statusActualValueTorque2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Рулёжка",
      "buttons": [
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "steerRatio", "label": "Передаточное число руля", "type": "number", "default": 15, "steps": [10, 11, 12, 13, 14, 15, 16, 17, 18, 20]},
    {"key": "steerDir", "label": "Направление руля", "type": "choice", "default": "normal",
